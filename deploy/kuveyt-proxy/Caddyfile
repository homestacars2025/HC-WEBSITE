# Kuveyt Türk Sanal POS — static-IP reverse proxy
#
# Purpose: make bank calls originate from the Easypanel server's IP
# (185.170.196.106) instead of Vercel's dynamic egress, which Kuveyt's gateway
# does not accept. The Vercel app points KUVEYT_PAYGATE_URL / KUVEYT_PROVISION_URL
# at this proxy; Caddy forwards each request to the bank unchanged (same path,
# same XML body) but from a whitelistable IP.
#
# TLS: the PUBLIC https cert for pay-proxy-caddy.gdsddq.easypanel.host is issued
# and terminated by Easypanel's own ingress (Traefik). This proxy therefore only
# listens on plain HTTP :80 *behind* that ingress — do NOT try to make Caddy
# obtain its own cert here.

:80 {
	# Local health check — answered here, never touches the bank.
	@health path /healthz
	respond @health "ok" 200

	# Everything else → Kuveyt Türk PRODUCTION gateway.
	#   - https:// upstream ⇒ Caddy dials over TLS (SNI + cert verify use the
	#     upstream host boa.kuveytturk.com.tr).
	#   - header_up Host … ⇒ the HTTP Host header the bank expects.
	#   - request path and body are preserved as-is, so the app's
	#     /sanalposservice/Home/ThreeDModel… path reaches the bank unchanged.
	# (For the TEST gateway instead, use https://boatest.kuveytturk.com.tr and
	#  the app path /boa.virtualpos.services/… .)
	reverse_proxy https://boa.kuveytturk.com.tr {
		header_up Host boa.kuveytturk.com.tr
	}

	# Send access logs to stdout so they show up in Easypanel → Logs.
	log {
		output stdout
		format console
	}
}
