# Kuveyt Türk Sanal POS — static-IP reverse proxy (+ 3DS callback relay)
#
# Two jobs on the same proxy (static IP 185.170.196.106, whitelisted by Kuveyt):
#   1. /sanalposservice/*  → the bank (boa.kuveytturk.com.tr). UNCHANGED — this
#      is what makes payments work.
#   2. /pay-callback       → relay the bank's 3DS result POST to a protected
#      Vercel PREVIEW, adding the automation-bypass as a HEADER (server-to-server,
#      no redirect) so the top-level POST + body survive (a query-param bypass
#      would 302→GET-downgrade it and drop the MD).
#
# Public TLS for pay-proxy-caddy.gdsddq.easypanel.host is terminated by Easypanel's
# ingress; Caddy listens plain HTTP :80 behind it.

:80 {
	# Local health check — answered here, never leaves the box.
	handle /healthz {
		respond "ok" 200
	}

	# ── 3DS callback relay → Vercel preview /api/payment/confirm ───────────────
	# reverse_proxy preserves method (POST), body (the url-encoded
	# AuthenticationResponse) and Content-Type, and does NOT redirect.
	# Host = the stable preview alias so Vercel routes to the right deployment;
	# the bypass HEADER clears Deployment Protection without a redirect.
	# >>> Replace PASTE_YOUR_BYPASS_SECRET_HERE with the Protection-Bypass-for-
	#     Automation secret from Vercel (Settings → Deployment Protection). <<<
	handle /pay-callback {
		rewrite * /api/payment/confirm
		reverse_proxy https://hc-kuveyt-cb.vercel.app {
			header_up Host hc-kuveyt-cb.vercel.app
			header_up x-vercel-protection-bypass PASTE_YOUR_BYPASS_SECRET_HERE
		}
	}

	# ── Kuveyt bank passthrough (catch-all, UNCHANGED) ─────────────────────────
	# Everything else — including /sanalposservice/Home/ThreeDModel… — goes to the
	# production bank exactly as before.
	handle {
		reverse_proxy https://boa.kuveytturk.com.tr {
			header_up Host boa.kuveytturk.com.tr
		}
	}

	log {
		output stdout
		format console
	}
}
